# --- Origen de Datos del Repositorio ---
# "database": usa PostgreSQL + SQLAlchemy (requiere PG_*).
# "faker":    usa adaptadores en memoria con datos sintéticos (sin DB).
# Por defecto: database
REPOSITORY_DATA_SOURCE=database

# --- Configuración Base ---
APP_NAME=Microservicio con GenCLI
ENVIRONMENT=development
DEBUG=false
API_VERSION=1.0.0

# --- PostgreSQL (obligatorio si REPOSITORY_DATA_SOURCE=database) ---
PG_USER=
PG_PASSWORD=
PG_HOST=
PG_PORT=5432
PG_DB=
PG_SSLMODE=disable
PG_CONNECT_TIMEOUT=10

# --- Paginación ---
# Requerido en modo database para firmar cursores.
# Opcional en modo faker (se genera uno efímero si está vacío).
PAGINATION_CURSOR_SECRET=

# --- Infraestructura (opcional) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
REDIS_URL=redis://localhost:6379/0
MEILISEARCH_URL=http://localhost:7700