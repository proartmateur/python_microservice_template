[
  {
    "name": "hex base",
    "path": "/src/modules/<snake_name>s",
    "short_option": "-x",
    "option": "--hex",
    "description": "Genera el núcleo hexagonal de un módulo sin casos de uso ni rutas HTTP",
    "has_props": true,
    "prop_type_separator": ":",
    "prop_prop_place": 1,
    "prop_type_place": 2,
    "prop_prefix": null,
    "templates": [
      {
        "template": "/hex/entities_template.py",
        "destination": "<path>/domain/entities.py"
      },
      {
        "template": "/hex/repositories_port_template.py",
        "destination": "<path>/domain/repositories.py"
      },
      {
        "template": "/hex/exceptions_template.py",
        "destination": "<path>/domain/exceptions.py"
      },
      {
        "template": "/hex/models_template.py",
        "destination": "<path>/infrastructure/persistence/models.py"
      },
      {
        "template": "/hex/repositories_adapter_template.py",
        "destination": "<path>/infrastructure/persistence/repositories.py"
      },
      {
        "template": "/hex/dependencies_template.py",
        "destination": "<path>/infrastructure/http/dependencies.py"
      },
      {
        "template": "/hex/router_base_template.py",
        "destination": "<path>/infrastructure/http/routers.py"
      },
      {
        "template": "/hex/schemas_base_template.py",
        "destination": "<path>/infrastructure/http/schemas.py"
      },
      {
        "template": "/hex/__init__.py",
        "destination": "<path>/__init__.py"
      },
      {
        "template": "/hex/__init__.py",
        "destination": "<path>/domain/__init__.py"
      },
      {
        "template": "/hex/__init__.py",
        "destination": "<path>/use_cases/__init__.py"
      },
      {
        "template": "/hex/__init__.py",
        "destination": "<path>/infrastructure/__init__.py"
      },
      {
        "template": "/hex/__init__.py",
        "destination": "<path>/infrastructure/http/__init__.py"
      },
      {
        "template": "/hex/__init__.py",
        "destination": "<path>/infrastructure/http/controllers/__init__.py"
      },
      {
        "template": "/hex/__init__.py",
        "destination": "<path>/infrastructure/persistence/__init__.py"
      },
      {
        "template": "/hex/scripts_init_template.py",
        "destination": "<path>/scripts/__init__.py"
      }
    ]
  },
  {
    "name": "hex use case list",
    "path": "/src/modules/<snake_name>s",
    "short_option": "-l",
    "option": "--uc-list",
    "description": "Genera el caso de uso de listado y registra sus contratos HTTP y persistencia",
    "has_props": true,
    "prop_type_separator": ":",
    "prop_prop_place": 1,
    "prop_type_place": 2,
    "prop_prefix": null,
    "templates": [
      {
        "template": "/hex/uc_list_use_case_template.py",
        "destination": "<path>/use_cases/list_<snake_name>s.py"
      },
      {
        "template": "/hex/uc_list_controller_template.py",
        "destination": "<path>/infrastructure/http/controllers/list_<snake_name>s_controller.py",
        "onDone": "python .gen_cli/scripts/register_uc_list.py <destination> <ent> <snake_name> \"<inline_props>\""
      },
      {
        "template": "/hex/uc_list_test_template.py",
        "destination": "/tests/unit/modules/<snake_name>s/test_list_<snake_name>s.py"
      }
    ]
  },
  {
    "name": "hex use case list paginated",
    "path": "/src/modules/<snake_name>s",
    "short_option": "-p",
    "option": "--uc-list-paginated",
    "description": "Genera listado keyset con cursor firmado, sin OFFSET",
    "has_props": true,
    "prop_type_separator": ":",
    "prop_prop_place": 1,
    "prop_type_place": 2,
    "prop_prefix": null,
    "templates": [
      {
        "template": "/hex/uc_list_paginated_use_case_template.py",
        "destination": "<path>/use_cases/list_paginated_<snake_name>s.py"
      },
      {
        "template": "/hex/uc_list_paginated_controller_template.py",
        "destination": "<path>/infrastructure/http/controllers/list_paginated_<snake_name>s_controller.py",
        "onDone": "python .gen_cli/scripts/register_uc_list_paginated.py <destination> <ent> <snake_name> \"<inline_props>\""
      },
      {
        "template": "/hex/uc_list_paginated_test_template.py",
        "destination": "/tests/unit/modules/<snake_name>s/test_list_paginated_<snake_name>s.py"
      }
    ]
  },
  {
    "name": "hex use case find by",
    "path": "/src/modules/<snake_name>s",
    "short_option": "-f",
    "option": "--uc-find-by",
    "description": "Genera búsqueda segura por campo con resultado limitado o keyset",
    "has_props": true,
    "prop_type_separator": ":",
    "prop_prop_place": 1,
    "prop_type_place": 2,
    "prop_prefix": null,
    "templates": [
      {
        "template": "/hex/uc_find_by_use_case_template.py",
        "destination": "<path>/use_cases/find_by_<snake_name>s.py"
      },
      {
        "template": "/hex/uc_find_by_controller_template.py",
        "destination": "<path>/infrastructure/http/controllers/find_by_<snake_name>s_controller.py",
        "onDone": "python .gen_cli/scripts/register_uc_find_by.py <destination> <ent> <snake_name> \"<inline_props>\""
      },
      {
        "template": "/hex/uc_find_by_test_template.py",
        "destination": "/tests/unit/modules/<snake_name>s/test_find_by_<snake_name>s.py"
      }
    ]
  },
  {
    "name": "hex use case create",
    "path": "/src/modules/<snake_name>s",
    "short_option": "-c",
    "option": "--uc-create",
    "description": "Genera creacion transaccional y registra sus contratos HTTP y persistencia",
    "has_props": true,
    "prop_type_separator": ":",
    "prop_prop_place": 1,
    "prop_type_place": 2,
    "prop_prefix": null,
    "templates": [
      {
        "template": "/hex/uc_create_use_case_template.py",
        "destination": "<path>/use_cases/create_<snake_name>s.py"
      },
      {
        "template": "/hex/uc_create_controller_template.py",
        "destination": "<path>/infrastructure/http/controllers/create_<snake_name>s_controller.py",
        "onDone": "python .gen_cli/scripts/register_uc_create.py <destination> <ent> <snake_name> \"<inline_props>\""
      },
      {
        "template": "/hex/uc_create_test_template.py",
        "destination": "/tests/unit/modules/<snake_name>s/test_create_<snake_name>s.py"
      }
    ]
  },
  {
    "name": "hex use case get",
    "path": "/src/modules/<snake_name>s",
    "short_option": "-g",
    "option": "--uc-get",
    "description": "Genera consulta individual y registra sus contratos HTTP y persistencia",
    "has_props": true,
    "prop_type_separator": ":",
    "prop_prop_place": 1,
    "prop_type_place": 2,
    "prop_prefix": null,
    "templates": [
      {
        "template": "/hex/uc_get_use_case_template.py",
        "destination": "<path>/use_cases/get_<snake_name>s.py"
      },
      {
        "template": "/hex/uc_get_controller_template.py",
        "destination": "<path>/infrastructure/http/controllers/get_<snake_name>s_controller.py",
        "onDone": "python .gen_cli/scripts/register_uc_get.py <destination> <ent> <snake_name> \"<inline_props>\""
      },
      {
        "template": "/hex/uc_get_test_template.py",
        "destination": "/tests/unit/modules/<snake_name>s/test_get_<snake_name>s.py"
      }
    ]
  },
  {
    "name": "mvc base",
    "path": "/src/modules/<snake_name>s",
    "short_option": "-m",
    "option": "--mvc",
    "description": "Genera lo esencial para tener un endpoint funcional, con controlador, servicio y repositorio",
    "prop_type_separator": ":",
    "prop_prop_place": 1,
    "prop_type_place": 2,
    "templates": [
      {
        "template": "/mvc/entities_template.py",
        "destination": "<path>/domain/entities.py"
      },
      {
        "template": "/mvc/persistence/models_template.py",
        "destination": "<path>/infrastructure/persistence/models.py"
      },
      {
        "template": "/mvc/persistence/repositories_template.py",
        "destination": "<path>/infrastructure/persistence/repositories.py"
      },
      {
        "template": "/mvc/scripts/create_ent_teable.py",
        "destination": "<path>/scripts/create_$snake_name$_table.py"
      },
      {
        "template": "/mvc/http/router_template.py",
        "destination": "<path>/infrastructure/http/routers.py"
      },
      {
        "template": "/mvc/http/controllers/create_controller_template.py",
        "destination": "<path>/infrastructure/http/controllers/create_$snake_name$_controller.py"
      },
      {
        "template": "/mvc/http/controllers/get_controller_template.py",
        "destination": "<path>/infrastructure/http/controllers/get_$snake_name$_controller.py"
      },
      {
        "template": "/mvc/http/controllers/list_controller_template.py",
        "destination": "<path>/infrastructure/http/controllers/list_$snake_name$s_controller.py"
      },
      {
        "template": "/mvc/http/controllers/update_controller_template.py",
        "destination": "<path>/infrastructure/http/controllers/update_$snake_name$_controller.py"
      },
      {
        "template": "/mvc/http/controllers/delete_controller_template.py",
        "destination": "<path>/infrastructure/http/controllers/delete_$snake_name$_controller.py"
      },
      {
        "template": "/mvc/http/schemas_template.py",
        "destination": "<path>/infrastructure/http/schemas.py"
      },
      {
        "template": "/mvc/__init__.py",
        "destination": "<path>/__init__.py"
      },
      {
        "template": "/mvc/__init__.py",
        "destination": "<path>/domain/__init__.py"
      },
      {
        "template": "/mvc/__init__.py",
        "destination": "<path>/infrastructure/__init__.py"
      },
      {
        "template": "/mvc/__init__.py",
        "destination": "<path>/infrastructure/http/__init__.py"
      },
      {
        "template": "/mvc/__init__.py",
        "destination": "<path>/infrastructure/http/controllers/__init__.py"
      },
      {
        "template": "/mvc/__init__.py",
        "destination": "<path>/infrastructure/persistence/__init__.py"
      },
      {
        "template": "/mvc/doc/readme_template.md",
        "destination": "<path>/doc/readme.md",
        "onDone": "echo <destination> >> gen.log"
      },
      {
        "template": "/tests/conftest_template.py",
        "destination": "/tests/e2e/<snake_name>s/conftest.py"
      },
      {
        "template": "/tests/test_flow_e2e_template.py",
        "destination": "/tests/e2e/<snake_name>s/test_<snake_name>s_flow_e2e.py"
      },
      {
        "template": "/tests/tests_doc_template.md",
        "destination": "/tests/e2e/<snake_name>s/tests_doc.md"
      }
    ]
  }
]
